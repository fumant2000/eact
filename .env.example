# Copier en .env (jamais commité) ; remplacer les change-me hors poste de dev.
NODE_ENV=development
HTTP_PORT=8080
# URL publique (liens des e-mails, QR des actes) ; IP du poste pour tester depuis un téléphone
PUBLIC_BASE_URL=http://localhost:8080

POSTGRES_USER=eact
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=eact
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=change-me-dev

S3_ROOT_USER=eact-s3
S3_ROOT_PASSWORD=change-me-dev-s3
S3_BUCKET_ACTES=actes
S3_BUCKET_PIECES=pieces

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# openssl rand -base64 32 — chiffre les secrets SMTP/SMS/GitHub en base (BF-66)
SECRETS_ENCRYPTION_KEY=change-me-32-bytes-base64

# ── Mode léger (api et web lancés par npm sur le poste) ; en conteneurs, docker-compose.yml les remplace ──
DATABASE_URL=postgresql://eact:change-me-dev@127.0.0.1:5433/eact?schema=public
REDIS_URL=redis://127.0.0.1:6380
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=EACT MINESUP <ne-pas-repondre@eact.test>
GOTENBERG_URL=http://127.0.0.1:3002
# URL du web en mode léger (liens des e-mails, QR des actes)
WEB_URL=http://localhost:3001
# Conteneurs : ClamAV réel = ANTIVIRUS_CONTENEURS=clamav + profil « antivirus »
ANTIVIRUS_CONTENEURS=simule
# Mode léger : antivirus simulé (refuse le fichier test EICAR), fichiers sur disque
ANTIVIRUS=simule
STOCKAGE=local
STOCKAGE_LOCAL_DIR=./.stockage
# Mot de passe des comptes de démo créés par le seed (hors production)
DEMO_MOT_DE_PASSE=Minesup@2026
# Mode démo : connexion en un clic, code TOTP affiché ; ignoré si NODE_ENV=production
DEMO_MODE=true

# GitHub App : laisser vide en dev, les gabarits du dossier gabarits/ sont chargés par le seed
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_TEMPLATES_REPO=org/eact-gabarits
# Sous-dossier et branche des gabarits dans le dépôt
GITHUB_TEMPLATES_PATH=
GITHUB_TEMPLATES_REF=main
# Sans GitHub App : jeton personnel en lecture (dépôt privé) ou rien (dépôt public)
GITHUB_TOKEN=
GITHUB_ISSUES_REPO=org/eact
# Clé privée de la GitHub App (ex. ./infra/secrets/github-app.pem) ; vide = pas de GitHub App
GITHUB_APP_KEY_FILE=

GRAFANA_ADMIN_PASSWORD=change-me

# Ports exposés sur le poste en dev (docker-compose.override.yml)
PG_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=3000
MAILPIT_HOST_PORT=8025
GOTENBERG_HOST_PORT=3002
