# Copier en .env — ne JAMAIS commiter le .env (CDC §22)
NODE_ENV=development
HTTP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

POSTGRES_USER=eact
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=eact
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=change-me-dev

S3_ROOT_USER=eact-s3
S3_ROOT_PASSWORD=change-me-dev-s3
S3_BUCKET_ACTES=actes
S3_BUCKET_PIECES=pieces

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# openssl rand -base64 32 — chiffre les secrets SMTP/SMS/GitHub en base (BF-66)
SECRETS_ENCRYPTION_KEY=change-me-32-bytes-base64

# ── Poste du développeur (mode léger : api et web lancés par npm sur le poste) ──
# Dans les conteneurs, ces adresses sont remplacées par les noms de service (docker-compose.yml).
DATABASE_URL=postgresql://eact:change-me-dev@localhost:5433/eact?schema=public
REDIS_URL=redis://localhost:6380
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=EACT MINESUP <ne-pas-repondre@eact.test>
GOTENBERG_URL=http://localhost:3002
# URL du frontend : liens des e-mails (réinitialisation) et URL du QR de vérification
WEB_URL=http://localhost:3001
# Services lourds désactivés en mode léger : antivirus simulé (refuse le fichier test EICAR), fichiers sur disque
ANTIVIRUS=simule
STOCKAGE=local
STOCKAGE_LOCAL_DIR=./.stockage
# Comptes de démonstration créés par le seed (jamais en production)
DEMO_MOT_DE_PASSE=Minesup@2026

# GitHub App (CDC §19.2) — laisser vide en dev : les gabarits viennent du cache/seed
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_TEMPLATES_REPO=org/eact-gabarits
GITHUB_ISSUES_REPO=org/eact
GITHUB_APP_KEY_FILE=./infra/secrets/github-app.pem

GRAFANA_ADMIN_PASSWORD=change-me

# Ports exposés sur le poste en dev (docker-compose.override.yml)
PG_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=3000
MAILPIT_HOST_PORT=8025
GOTENBERG_HOST_PORT=3002
