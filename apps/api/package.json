{
  "name": "@eact/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "lint": "tsc --noEmit -p tsconfig.json",
